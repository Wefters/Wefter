<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- WEFTER-PERMISSIONS-START -->

    <!-- WEFTER-PERMISSIONS-END -->

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Wefter">
        <!-- configChanges: rotating, resizing (split screen, foldables), attaching a keyboard or switching
             dark mode keeps the activity and resizes the web view, instead of recreating the activity and
             reloading the web app. -->
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.App.Starting"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link intent filters are added per environment: `wefter sync` writes them to
                 src/<env>/AndroidManifest.xml, which Gradle merges into this activity. -->
        </activity>

        <!-- WEFTER-COMPONENTS-START -->

        <!-- WEFTER-COMPONENTS-END -->
    </application>

</manifest>

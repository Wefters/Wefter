<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- WEFTER-PERMISSIONS-START -->

    <!-- WEFTER-PERMISSIONS-END -->

    <!-- The camera, microphone and GPS are used when the app or a plugin asks for them, but are not
         required: without these lines, declaring their permissions would hide the app from devices
         that lack them in Google Play. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <!-- Lets the app see the camera apps it offers for <input type="file"> (Android 11+ hides other
         apps unless the manifest names what it looks for). -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
        <!-- Browsers that can show pages in the app (Custom Tabs), for the in-app browser. -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Wefter">
        <!-- configChanges: rotating, resizing (split screen, foldables), attaching a keyboard or switching
             dark mode keeps the activity and resizes the web view, instead of recreating the activity and
             reloading the web app. -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App.Starting"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link intent filters are added per environment: `wefter sync` writes them to
                 src/<env>/AndroidManifest.xml, which Gradle merges into this activity. -->
        </activity>

        <!-- Shares photos and videos the camera app takes for <input type="file"> with the camera app. -->
        <provider
            android:name=".WefterFileProvider"
            android:authorities="${applicationId}.wefter.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/wefter_file_paths" />
        </provider>

        <!-- WEFTER-COMPONENTS-START -->

        <!-- WEFTER-COMPONENTS-END -->
    </application>

</manifest>

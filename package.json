{
  "name": "wefter",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "demo:dev:ios": "pnpm --filter wefter-demo-app run wefter:dev:ios",
    "demo:dev:android": "pnpm --filter wefter-demo-app run wefter:dev:android",
    "demo:build:ios": "pnpm --filter wefter-demo-app run wefter:build:ios",
    "demo:build:android": "pnpm --filter wefter-demo-app run wefter:build:android",
    "docs:dev": "pnpm --filter @wefter/docs run dev",
    "docs:build": "pnpm --filter @wefter/docs run build"
  }
}
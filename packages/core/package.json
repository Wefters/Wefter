{
  "name": "@wefterjs/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "prebuild": "node scripts/gen-version.mjs",
    "build": "tsc -p tsconfig.json",
    "build:testpage": "esbuild src/test-only-global.ts --bundle --format=iife --outfile=dist/wefter-test-global.js",
    "pretest": "node scripts/gen-version.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.23.1",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}

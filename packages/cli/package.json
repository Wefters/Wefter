{
  "name": "@wefterjs/cli",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "wefter": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "node scripts/gen-version.mjs",
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "pretest": "node scripts/gen-version.mjs",
    "test": "vitest run",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@wefterjs/registry-codegen": "workspace:*",
    "esbuild": "^0.23.1",
    "tsx": "^4.23.7",
    "typescript": "~6.0.3",
    "vitest": "^2.1.9"
  }
}

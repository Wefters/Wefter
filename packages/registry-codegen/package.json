    "test": "vitest run",
    "generate": "pnpm build && node dist/generate.js"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
